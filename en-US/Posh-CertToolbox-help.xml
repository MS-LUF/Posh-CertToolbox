    <command:examples>
      <command:example>
        <maml:title>-------------------------- EXAMPLE 1 --------------------------</maml:title>
        <dev:code>Get-CertToolboxCaaRecord -Name 'www.example.com'</dev:code>
        <dev:remarks>
          <maml:para>Shows which CAs may issue for www.example.com and where the restriction is defined.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------------------- EXAMPLE 2 --------------------------</maml:title>
        <dev:code>'example.com', 'example.org' | Get-CertToolboxCaaRecord | Select-Object Name, RecordSetName, Issue, IssueWild</dev:code>
        <dev:remarks>
          <maml:para></maml:para>
        </dev:remarks>
      </command:example>
