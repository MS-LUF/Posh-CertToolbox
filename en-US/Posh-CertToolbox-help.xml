  <command:command xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" xmlns:MSHelp="http://msdn.microsoft.com/mshelp">
    <command:details>
      <command:name>Test-CertToolboxTlsProtocol</command:name>
      <command:verb>Test</command:verb>
      <command:noun>CertToolboxTlsProtocol</command:noun>
      <maml:description>
        <maml:para>Probes a TLS endpoint once per protocol version and reports which ones could be negotiated.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Makes a separate connection for each protocol version, offering only that version, and returns one result per version.</maml:para>
      <maml:para>Read the Negotiated property as "could be negotiated from this machine", not as "the server supports it". The handshake is done by the operating system's TLS stack, and a version that the local system has disabled or does not implement fails here whatever the server accepts; ErrorType and ErrorMessage carry the underlying failure so the two cases can be told apart. A $true result is always conclusive; a $false one only is when the same version works from this machine against another server.</maml:para>
      <maml:para>Mail servers that start in plaintext and upgrade to TLS are probed with the StartTls parameter; the plaintext exchange is then repeated on each connection. When that exchange itself fails (the server does not offer the upgrade, for instance), every version is reported as not negotiated with that error.</maml:para>
    </maml:description>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>Test-CertToolboxTlsProtocol</maml:name>
        <command:parameter required="true" variableLength="true" globbing="false" pipelineInput="True (ByPropertyName, ByValue)" position="1" aliases="ComputerName, DnsName">
