  <command:command xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" xmlns:MSHelp="http://msdn.microsoft.com/mshelp">
    <command:details>
      <command:name>Get-CertToolboxCaaRecord</command:name>
      <command:verb>Get</command:verb>
      <command:noun>CertToolboxCaaRecord</command:noun>
      <maml:description>
        <maml:para>Gets the DNS CAA records that apply to a domain, telling which CAs may issue for it.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Looks up the CAA record set relevant to each name the way a CA has to (RFC 8659): the name itself first, then each parent domain in turn until a CAA record set is found. The output says which name the records were found on.</maml:para>
      <maml:para>HasCaaRecord is $false when no CAA record exists anywhere up the tree: issuance is not restricted, any CA may issue.</maml:para>
      <maml:para>Issue lists the CA domains allowed to issue. IssueRestricted is $true when the record set has at least one "issue" record; an empty Issue list with IssueRestricted $true means no CA may issue at all.</maml:para>
      <maml:para>IssueWild is the same for wildcard certificates. When the record set has no "issuewild" record, wildcard issuance follows the "issue" records, and IssueWild repeats them.</maml:para>
      <maml:para>Record holds every record of the set as returned, including tags this cmdlet does not interpret.</maml:para>
      <maml:para>DNS is queried through Google's DNS-over-HTTPS API (dns.google), so it works identically on every platform; the names queried are sent to that service.</maml:para>
    </maml:description>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>Get-CertToolboxCaaRecord</maml:name>
        <command:parameter required="true" variableLength="true" globbing="false" pipelineInput="True (ByPropertyName, ByValue)" position="1" aliases="Domain, DnsName, HostName">
          <maml:name>Name</maml:name>
          <maml:description>
            <maml:para>One or more DNS names. A leading "*." is ignored, so a wildcard name can be given as is.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">String[]</command:parameterValue>
          <dev:type>
            <maml:name>String[]</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>None</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="named" aliases="none">
          <maml:name>TimeoutSec</maml:name>
          <maml:description>
            <maml:para>Timeout, in seconds, of each DNS query.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">Int32</command:parameterValue>
          <dev:type>
            <maml:name>Int32</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>10</dev:defaultValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="true" variableLength="true" globbing="false" pipelineInput="True (ByPropertyName, ByValue)" position="1" aliases="Domain, DnsName, HostName">
        <maml:name>Name</maml:name>
